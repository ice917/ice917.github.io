{{- /*
  一本书（一个顶级 section）的知识地图数据。
  节点 = 本书笔记 + 标签枢纽
  边   = 笔记→标签（front matter 里的 tags）
        笔记→笔记（正文里指向本书其他笔记的 /<section>/<slug>/ 链接）
        章节→章节（front matter 声明了 weight 时，按 weight 升序把相邻两页连起来）
  单一事实源：不写死任何关系，全部从内容文件推导。
  跨书的链接目标不在本书节点里，前端会自动丢弃这类边。
*/ -}}
{{- $pages := .RegularPages -}}
{{- $section := .Section -}}
{{- $prefix := printf "/%s/" $section -}}
{{- $linkPattern := printf `/%s/[A-Za-z0-9_\-]+` $section -}}
{{- $nodes := slice -}}
{{- $links := slice -}}

{{- /* ---------- 笔记节点 ---------- */ -}}
{{- range $pages -}}
  {{- $slug := .File.ContentBaseName -}}
  {{- $nodes = $nodes | append (dict
      "id" $slug
      "label" .Title
      "url" .RelPermalink
      "kind" "note"
      "date" (.Date.Format "2006-01-02")
      "summary" (.Summary | plainify | truncate 100 "")
  ) -}}
{{- end -}}

{{- /* ---------- 标签枢纽节点 ---------- */ -}}
{{- $tagTerms := slice -}}
{{- range $pages -}}
  {{- range .Params.tags -}}
    {{- $tagTerms = $tagTerms | append . -}}
  {{- end -}}
{{- end -}}
{{- $tagTerms = $tagTerms | uniq | sort -}}

{{- range $tagTerms -}}
  {{- $t := . -}}
  {{- $tagURL := printf "/tags/%s/" $t -}}
  {{- with site.GetPage (printf "/tags/%s" $t) -}}
    {{- $tagURL = .RelPermalink -}}
  {{- end -}}
  {{- $nodes = $nodes | append (dict
      "id" (printf "tag:%s" $t)
      "label" $t
      "url" $tagURL
      "kind" "tag"
  ) -}}
{{- end -}}

{{- /* ---------- 边 ---------- */ -}}
{{- range $pages -}}
  {{- $slug := .File.ContentBaseName -}}

  {{- /* 标签归属边 */ -}}
  {{- range .Params.tags -}}
    {{- $links = $links | append (dict
        "source" $slug
        "target" (printf "tag:%s" .)
        "kind" "tag"
    ) -}}
  {{- end -}}

  {{- /* 正文互链边：识别本书里的 /<section>/<slug> 形式 */ -}}
  {{- range findRE $linkPattern .RawContent -}}
    {{- $target := . | replaceRE $prefix "" | replaceRE `\.md$` "" -}}
    {{- if ne $target $slug -}}
      {{- $links = $links | append (dict
          "source" $slug
          "target" $target
          "kind" "link"
      ) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* ---------- 顺序边 ---------- */ -}}
{{- /* 声明了 weight 的页面按 weight 升序相邻相连。
       没有 weight 的书（notes）完全不受影响：$weighted 为空，不产生任何 seq 边。 */ -}}
{{- $weighted := slice -}}
{{- range $pages -}}
  {{- if gt .Weight 0 -}}
    {{- $weighted = $weighted | append . -}}
  {{- end -}}
{{- end -}}
{{- $weighted = sort $weighted "Weight" -}}
{{- range $i, $p := $weighted -}}
  {{- if lt $i (sub (len $weighted) 1) -}}
    {{- $next := index $weighted (add $i 1) -}}
    {{- $links = $links | append (dict
        "source" $p.File.ContentBaseName
        "target" $next.File.ContentBaseName
        "kind" "seq"
    ) -}}
  {{- end -}}
{{- end -}}

{{- dict "nodes" $nodes "links" $links | jsonify (dict "indent" "  ") -}}
